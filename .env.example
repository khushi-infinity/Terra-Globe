# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_MAPBOX_ACCESS_TOKEN: Required for Mapbox GL JS 3D street level view and geocoding.
VITE_MAPBOX_ACCESS_TOKEN=""

# AWS CREDENTIALS & REGION (OPTIONAL FOR LIVE AWS CLOUD WRITES)
# When not set, TERRA operates in Track 1 "Build It" mode with LocalStack / local emulation.
# Set these to connect to your live AWS account for Track 2 "Ship It":
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
TERRA_S3_BUCKET="terra-evidence-storage"
DYNAMODB_REPORTS_TABLE="TerraReports"
DYNAMODB_POSTS_TABLE="TerraPosts"
